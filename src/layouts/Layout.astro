---
import "../styles/global.css";
// Después de Tailwind: a igual especificidad gana Ant Design sobre el preflight
import "../styles/antd.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Passo es el software de gestión para academias de baile: pagos, asistencia y progreso de alumnos. Planes desde $49.900 COP al mes. Demo gratis de 30 días con todas las funciones Pro.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// og:image se queda en PNG: varios scrapers de redes todavía no leen WebP.
const ogImage = new URL("/images/hero/slide-1-laptop.png", Astro.site);

const site = Astro.site!.href;
const abs = (path: string) => new URL(path, Astro.site).href;

// @id enlaza los nodos entre sí: Google los lee como una sola entidad "Passo"
// en vez de tres fichas sueltas. Sin sameAs ni aggregateRating: no hay perfiles
// sociales ni reseñas reales todavía, e inventarlos es penalizable.
const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Organization",
            "@id": `${site}#organization`,
            name: "Passo",
            url: site,
            logo: {
                "@type": "ImageObject",
                url: abs("/android-chrome-512x512.png"),
                width: 512,
                height: 512,
            },
            image: ogImage.href,
            slogan: "Toda transformación comienza con un paso.",
            description:
                "Passo desarrolla software de gestión para academias de baile: pagos, asistencia, calendario de clases y seguimiento del progreso de los alumnos.",
            email: "contacto@passodance.com",
            knowsLanguage: "es",
            contactPoint: {
                "@type": "ContactPoint",
                contactType: "customer service",
                email: "contacto@passodance.com",
                availableLanguage: ["Spanish"],
            },
        },
        {
            "@type": "WebSite",
            "@id": `${site}#website`,
            url: site,
            name: "Passo",
            description,
            inLanguage: "es",
            publisher: { "@id": `${site}#organization` },
        },
        {
            "@type": "SoftwareApplication",
            "@id": `${site}#software`,
            name: "Passo",
            url: site,
            description:
                "Plataforma de gestión para academias de baile: control de pagos, asistencia, calendario de clases y seguimiento del progreso de los alumnos.",
            applicationCategory: "BusinessApplication",
            applicationSubCategory: "Software de gestión para academias de baile",
            operatingSystem: "Web, iOS, Android",
            inLanguage: "es",
            image: ogImage.href,
            screenshot: ogImage.href,
            publisher: { "@id": `${site}#organization` },
            featureList: [
                "Control de pagos y cobros recurrentes",
                "Registro de asistencia por clase",
                "Calendario de clases y horarios",
                "Seguimiento del progreso de los alumnos",
                "App para alumnos en iOS y Android",
            ],
            offers: [
                ...[
                    { name: "Estudio", alumnos: "Hasta 50 alumnos activos", basico: 49900, pro: 79900 },
                    { name: "Academia", alumnos: "De 51 a 150 alumnos activos", basico: 99900, pro: 139900 },
                    { name: "Compañía", alumnos: "Más de 150 alumnos activos", basico: 179900, pro: 229900 },
                ].map((p) => ({
                    "@type": "AggregateOffer",
                    name: `Plan ${p.name}`,
                    lowPrice: String(p.basico),
                    highPrice: String(p.pro),
                    priceCurrency: "COP",
                    description: `${p.alumnos} al mes; funcionalidades Básicas o Pro`,
                    url: site,
                    availability: "https://schema.org/InStock",
                })),
            ],
        },
    ],
};
---

<!doctype html>
<html lang="es" class="scroll-smooth overflow-x-hidden">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <link rel="canonical" href={canonical} />
        <link rel="icon" href="/favicon.ico" sizes="48x48" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#F4F7FB" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Passo" />
        <meta property="og:locale" content="es_CO" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1750" />
        <meta property="og:image:height" content="1750" />
        <meta property="og:image:alt" content="Panel de control de Passo para academias de baile" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content="Panel de control de Passo para academias de baile" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700;1,800&family=Caveat:wght@500;600&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />

        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </head>
    <body
        class="bg-fondo text-tinta antialiased overflow-x-hidden max-w-[100vw]"
    >
        <slot />
    </body>
</html>
