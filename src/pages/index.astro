---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero";
import FeaturesGrid from "../components/FeaturesGrid";
import Manifesto from "../components/Manifesto";
import Steps from "../components/Steps";
import Calculadora from "../components/Calculadora";
import Pricing from "../components/Pricing";
import Footer from "../components/Footer";
import ModalManager from "../components/modals/ModalManager";
---

<Layout title="Passo — Software de gestión para academias de baile">
    <Navbar client:load />

    <main class="min-h-screen">
        <Hero client:load />
        <FeaturesGrid client:visible />
        <Manifesto client:visible />
        <Steps client:visible />
        <Calculadora client:visible />
        <Pricing client:visible />
    </main>

    <Footer client:visible />
    <ModalManager client:load />
</Layout>
